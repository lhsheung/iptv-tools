<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IptvTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:IptvTools.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 标题栏（自绘，避免占掉一整条系统栏高度） ───────────────────── -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="48"
              Background="{ThemeResource AppSurfaceBrush}"
              Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE7F4;" FontSize="12"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="IPTV Tools" FontSize="13.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="TitleBarSubtitle"
                       Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
                       FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Click="OnToggleTheme"
                        Style="{StaticResource SubtleIconButton}" ToolTipService.ToolTip="切换深浅色">
                    <FontIcon Glyph="&#xE706;" FontSize="14" />
                </Button>
                <Button x:Name="LogButton" Click="OnToggleLog"
                        Style="{StaticResource SubtleIconButton}" ToolTipService.ToolTip="查看运行日志">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── 主内容：三栏（源信息 / 频道列表 / 侧栏） ────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：导航 -->
            <Border Grid.Column="0" Width="196"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="10,14,10,14" Spacing="4">
                        <TextBlock Text="操作" FontSize="11.5" FontWeight="SemiBold"
                                   Margin="8,0,0,6"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}" />

                        <Button x:Name="ImportFileBtn" Click="OnImportFile"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                                <TextBlock Text="打开文件…" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ImportUrlBtn" Click="OnImportUrl"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE774;" FontSize="15" />
                                <TextBlock Text="从网址载入…" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="6,8" />

                        <TextBlock Text="测试" FontSize="11.5" FontWeight="SemiBold"
                                   Margin="8,0,0,6"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}" />

                        <Button x:Name="TestAllBtn" Click="OnTestAll"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE768;" FontSize="15" />
                                <TextBlock Text="测试全部" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TestVisibleBtn" Click="OnTestVisible"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE71C;" FontSize="15" />
                                <TextBlock Text="测试当前列表" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TestFailedBtn" Click="OnTestFailed"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72C;" FontSize="15" />
                                <TextBlock Text="重测失败项" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CancelBtn" Click="OnCancelTest"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE711;" FontSize="15" />
                                <TextBlock Text="停止测试" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="6,8" />

                        <TextBlock Text="导出" FontSize="11.5" FontWeight="SemiBold"
                                   Margin="8,0,0,6"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}" />

                        <Button x:Name="ExportM3uBtn" Click="OnExportM3u"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE896;" FontSize="15" />
                                <TextBlock Text="导出 M3U…" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ExportDplBtn" Click="OnExportDpl"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE896;" FontSize="15" />
                                <TextBlock Text="导出 DPL…" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{ThemeResource AppDividerBrush}" Margin="6,8" />

                        <Button x:Name="ClearBtn" Click="OnClearAll"
                                Style="{StaticResource NavActionButton}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                <TextBlock Text="清空列表" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中：频道列表 -->
            <Grid Grid.Column="1" Padding="20,16,20,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 头部：标题 + 统计 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="频道" FontSize="26" FontWeight="SemiBold"
                                   FontFamily="{ThemeResource AppDisplayFontFamily}"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock x:Name="SummaryLine" FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 统计胶囊 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Bottom">
                        <Border Style="{StaticResource StatPill}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="可用" FontSize="11.5"
                                           Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="ValidStat" Text="0" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppSuccessBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatPill}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="总数" FontSize="11.5"
                                           Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                <TextBlock x:Name="TotalStat" Text="0" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 工具条：搜索 + 筛选 -->
                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="0"
                                    PlaceholderText="搜索频道名、分组或地址"
                                    QueryIcon="Find"
                                    TextChanged="OnSearchChanged"
                                    Style="{StaticResource RoundedSearchBox}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="FilterAll" Content="全部" IsChecked="True"
                                      Click="OnFilterClick" Tag="all"
                                      Style="{StaticResource FilterToggle}" />
                        <ToggleButton x:Name="FilterValid" Content="可用"
                                      Click="OnFilterClick" Tag="valid"
                                      Style="{StaticResource FilterToggle}" />
                        <ToggleButton x:Name="FilterInvalid" Content="不可用"
                                      Click="OnFilterClick" Tag="invalid"
                                      Style="{StaticResource FilterToggle}" />
                        <ToggleButton x:Name="FilterUntested" Content="未测"
                                      Click="OnFilterClick" Tag="untested"
                                      Style="{StaticResource FilterToggle}" />
                    </StackPanel>
                </Grid>

                <!-- 列表本体 -->
                <Border Grid.Row="2" CornerRadius="12"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppDividerBrush}"
                        BorderThickness="1">
                    <Grid>
                        <ListView x:Name="ChannelList"
                                  ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Padding="0,4"
                                  ItemContainerStyle="{StaticResource ChannelItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChannelRow">
                                    <Grid Padding="14,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 勾选 -->
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  MinWidth="0" VerticalAlignment="Center" />

                                        <!-- 状态点 -->
                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11"
                                                VerticalAlignment="Center"
                                                Background="{Binding State, Converter={StaticResource StateBgConverter}}">
                                            <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                                                      FontSize="10.5"
                                                      Foreground="{Binding State, Converter={StaticResource StateFgConverter}}" />
                                        </Border>

                                        <!-- 名称 + 元信息 -->
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind MetaLine, Mode=OneWay}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- 行内操作 -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource SubtleIconButton}"
                                                    Click="OnRowDecode" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="FFmpeg 解码检测">
                                                <FontIcon Glyph="&#xE786;" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource SubtleIconButton}"
                                                    Click="OnRowTest" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="重测这一行">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空态 -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Spacing="10"
                                    Visibility="Visible">
                            <FontIcon Glyph="&#xE8B7;" FontSize="30"
                                      Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            <TextBlock Text="还没有载入播放列表" FontSize="13.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            <TextBlock Text="支持 M3U / M3U8 / TXT / PotPlayer DPL" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            <Button Content="打开文件…" Click="OnImportFile"
                                    Style="{StaticResource AccentRoundedButton}"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：测试参数 -->
            <Border Grid.Column="2" Width="272"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppDividerBrush}"
                    BorderThickness="1,1,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18,16,18,20" Spacing="14">

                        <TextBlock Text="测试参数" FontSize="17" FontWeight="SemiBold"
                                   FontFamily="{ThemeResource AppDisplayFontFamily}"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />

                        <!-- 检测方式 -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="检测方式" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnModeChanged"
                                      Style="{StaticResource RoundedComboBox}">
                                <ComboBoxItem Content="HTTP 探活（快）" Tag="http" IsSelected="True" />
                                <ComboBoxItem Content="FFmpeg 真解码（准）" Tag="ffmpeg" />
                                <ComboBoxItem Content="两者叠加（最稳）" Tag="both" />
                            </ComboBox>
                            <TextBlock x:Name="ModeHint" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                                       Text="仅检查 HTTP 响应与流特征，速度最快。" />
                        </StackPanel>

                        <!-- 数值参数 -->
                        <StackPanel Spacing="7">
                            <Grid>
                                <TextBlock Text="并发线程" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="WorkersValue" Text="8" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Grid>
                            <Slider x:Name="WorkersSlider" Minimum="1" Maximum="32" Value="8"
                                    StepFrequency="1" ValueChanged="OnWorkersChanged" />
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <Grid>
                                <TextBlock Text="请求超时" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="TimeoutValue" Text="15 秒" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Grid>
                            <Slider x:Name="TimeoutSlider" Minimum="3" Maximum="60" Value="15"
                                    StepFrequency="1" ValueChanged="OnTimeoutChanged" />
                        </StackPanel>

                        <StackPanel x:Name="DecodeSecondsPanel" Spacing="7" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="解码时长" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="DecodeValue" Text="3 秒" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Grid>
                            <Slider x:Name="DecodeSlider" Minimum="1" Maximum="15" Value="3"
                                    StepFrequency="1" ValueChanged="OnDecodeChanged" />
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <Grid>
                                <TextBlock Text="流畅度下限" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock x:Name="ScoreValue" Text="10" FontSize="12"
                                           HorizontalAlignment="Right"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Grid>
                            <Slider x:Name="ScoreSlider" Minimum="0" Maximum="100" Value="10"
                                    StepFrequency="5" ValueChanged="OnScoreChanged" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                        <StackPanel Spacing="10">
                            <ToggleSwitch x:Name="CheckLiveSwitch" Header="检测直播状态"
                                          IsOn="True" Toggled="OnToggleOption"
                                          Style="{StaticResource CompactToggleSwitch}" />
                            <ToggleSwitch x:Name="CheckFluencySwitch" Header="计算流畅度评分"
                                          IsOn="True" Toggled="OnToggleOption"
                                          Style="{StaticResource CompactToggleSwitch}" />
                            <ToggleSwitch x:Name="StrictSwitch" Header="严格校验"
                                          IsOn="True" Toggled="OnToggleOption"
                                          Style="{StaticResource CompactToggleSwitch}" />
                            <ToggleSwitch x:Name="QuickLiveSwitch" Header="快速直播检测"
                                          IsOn="False" Toggled="OnToggleOption"
                                          Style="{StaticResource CompactToggleSwitch}" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                        <!-- 环境状态 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="后端环境" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            <TextBlock x:Name="WorkerStatusText" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            <TextBlock x:Name="FfmpegStatusText" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            <TextBlock x:Name="Ip2RegionStatusText" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- ── 底部进度条（仅在测试时显示） ─────────────────────────────────── -->
        <Grid Grid.Row="1" x:Name="ProgressOverlay" Visibility="Collapsed"
              VerticalAlignment="Bottom" Height="3">
            <ProgressBar x:Name="MainProgress" IsIndeterminate="False"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                         Background="Transparent" />
        </Grid>

        <!-- ── 日志抽屉 ────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" x:Name="LogDrawer" Visibility="Collapsed"
                VerticalAlignment="Bottom" Height="168"
                Background="{ThemeResource AppSurfaceAltBrush}"
                BorderBrush="{ThemeResource AppDividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="16,8">
                    <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <Button Content="清空" HorizontalAlignment="Right" Click="OnClearLog"
                            Style="{StaticResource LinkTextButton}" />
                </Grid>
                <ListView Grid.Row="1" x:Name="LogList" Padding="8,0,8,8"
                          SelectionMode="None"
                          ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="11.5"
                                       FontFamily="{ThemeResource AppMonoFontFamily}"
                                       TextWrapping="NoWrap"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ── 状态条（底部一行） ─────────────────────────────────────────── -->
        <Grid Grid.Row="1" x:Name="StatusStrip" VerticalAlignment="Bottom" Height="26"
              Background="{ThemeResource AppSurfaceAltBrush}"
              BorderBrush="{ThemeResource AppDividerBrush}"
              BorderThickness="0,1,0,0" Padding="14,0">
            <TextBlock x:Name="StatusText" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{ThemeResource AppTextTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

    </Grid>
</Window>
