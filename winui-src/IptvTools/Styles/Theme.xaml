<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        设计基调（apple-design 取向）
        - 单一色相（系统 accent 蓝），不铺渐变、不加彩色描边
        - 靠留白与层级分隔，而不是靠线和阴影堆叠
        - 圆角统一 8 / 12 两级，不使用胶囊+斜角混搭
        - 动效只保留必要的 150~250ms 淡入与位置过渡
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FAFBFC" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#EBEDF0" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1C1D21" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#6B7075" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#9AA0A6" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E8F1FE" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#1A9E56" />
            <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#E6F5EC" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#D93A2B" />
            <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#FDECEA" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#C77700" />
            <SolidColorBrush x:Key="AppWarnSoftBrush" Color="#FDF3E2" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="#F0F2F5" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="#1B1C1F" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#232428" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#1F2024" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#26272C" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#33353A" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#A9AEB4" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#7B8085" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#22303F" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#4CC281" />
            <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#1D2E24" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#F0655A" />
            <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#33211F" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#E0A34E" />
            <SolidColorBrush x:Key="AppWarnSoftBrush" Color="#33291B" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="#2E3035" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppDangerSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AppWarnSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AppHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ── 字号阶梯：只用 4 档，避免界面出现 17 种字号 ───────────────────── -->
    <x:Double x:Key="TitleSize">26</x:Double>
    <x:Double x:Key="HeadlineSize">17</x:Double>
    <x:Double x:Key="BodySize">13.5</x:Double>
    <x:Double x:Key="CaptionSize">12</x:Double>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <CornerRadius x:Key="CardCorner">12</CornerRadius>
    <CornerRadius x:Key="ControlCorner">8</CornerRadius>

</ResourceDictionary>
